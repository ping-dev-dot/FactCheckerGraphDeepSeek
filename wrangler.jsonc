{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "factchecker-graph",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AnalysisPipelineDO"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["AnalysisPipelineDO"]
    }
  ]
}
